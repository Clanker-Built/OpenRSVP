[Desktop Entry]
Type=Application
Name=OpenRSVP
GenericName=Speed Reader
Comment=Rapid Serial Visual Presentation reader for PDFs, books, articles and websites
Exec=/opt/OpenRSVP/openrsvp --no-sandbox %U
Icon=openrsvp
Terminal=false
Categories=Office;Viewer;
StartupWMClass=OpenRSVP
MimeType=application/pdf;application/epub+zip;application/msword;application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/plain;text/markdown;text/html;
